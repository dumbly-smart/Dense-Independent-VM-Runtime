From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] accel/tcg: trace generated translation block sizes

Emit a completion event after a TB's generated host-code size is known.
The existing translate_block event occurs before code generation, so it
cannot report this value. This event reports cumulative generated bytes;
it does not measure translation duration or currently resident cache bytes.

--- a/accel/tcg/trace-events
+++ b/accel/tcg/trace-events
@@ -11,8 +11,9 @@
 memory_notdirty_set_dirty(uint64_t vaddr) "0x%" PRIx64

 # translate-all.c
 translate_block(void *tb, uintptr_t pc, const void *tb_code) "tb:%p, pc:0x%"PRIxPTR", tb_code:%p"
+translate_block_complete(void *tb, uintptr_t pc, int code_size) "tb:%p, pc:0x%"PRIxPTR", code_size:%d"
 tb_gen_code_buffer_overflow(const char *reason) "reason: %s"

 # ldst_atomicity
 load_atom2_fallback(uint32_t memop, uintptr_t ra) "mop:0x%"PRIx32", ra:0x%"PRIxPTR""
--- a/accel/tcg/translate-all.c
+++ b/accel/tcg/translate-all.c
@@ -397,5 +397,6 @@ TranslationBlock *tb_gen_code(CPUState *cpu, TCGTBCPUState s)
     tb->tc.size = gen_code_size;
+    trace_translate_block_complete(tb, s.pc, gen_code_size);
 
     /*
      * For CF_PCREL, attribute all executions of the generated code
      * to its first mapping.

-- 
