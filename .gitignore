# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/.ignore
/target/
/results/vcpu-multi2/*
!/results/vcpu-multi2/README.md
!/results/vcpu-multi2/result.json
/results/vcpu-multi2-run2/*
!/results/vcpu-multi2-run2/result.json
/results/vcpu-qmp-smoke-2026-10-29/*
!/results/vcpu-qmp-smoke-2026-10-29/README.md
!/results/vcpu-qmp-smoke-2026-10-29/result.json
/results/vcpu-topology-2026-10-29/*
!/results/vcpu-topology-2026-10-29/README.md
!/results/vcpu-topology-2026-10-29/baseline-000.qemu.log
/results/kvm-entry-2026-10-29/*
!/results/kvm-entry-2026-10-29/README.md
!/results/kvm-entry-2026-10-29/baseline-000.qemu.log
/results/kvm-single-entry-recheck-2026-10-29/
/results/kvm-cpu-model-smoke-2026-10-29/*
!/results/kvm-cpu-model-smoke-2026-10-29/README.md
!/results/kvm-cpu-model-smoke-2026-10-29/result.json
